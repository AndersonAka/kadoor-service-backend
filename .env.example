# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kadoor_db

# JWT
JWT_SECRET=your-jwt-secret-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GeniusPay (clés uniquement côté serveur)
GENIUSPAY_API_KEY=pk_sandbox_xxx
GENIUSPAY_API_SECRET=sk_sandbox_xxx
GENIUSPAY_WEBHOOK_SECRET=whsec_xxx

# OneSignal (Push + Email)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Email Configuration (used by OneSignal)
EMAIL_FROM_NAME=KADOOR SERVICE
EMAIL_FROM_ADDRESS=no-reply@mail.kadoorservice.com

# Frontend URL (for email links + GeniusPay success/error callbacks)
FRONTEND_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
WEB_APP_DEFAULT_LOCALE=fr

# Server
PORT=3001
